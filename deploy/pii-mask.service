# systemd user-unit для микросервиса pii-mask.
# Ставится deploy.sh в ~/.config/systemd/user/ (нужен loginctl enable-linger).
[Unit]
Description=pii-mask - local PII masking gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/pii-mask
ExecStart=%h/pii-mask/.venv/bin/pii-mask serve --host 127.0.0.1 --port 8377
Restart=on-failure
RestartSec=3
# в stdout сервиса нет тел запросов (см. api.py) - journald безопасен

[Install]
WantedBy=default.target
